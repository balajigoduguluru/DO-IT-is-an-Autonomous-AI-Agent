{
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "pip install -e .",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "regions": ["iad1"],
  "env": {
    "PYTHONPATH": "."
  }
}